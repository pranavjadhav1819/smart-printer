# Copy to .env and edit. Never commit .env.
PORT=3000
BASE_URL=http://localhost:3000        # public address customers will open (used inside the QR code)
# If the pages are hosted on Vercel (or elsewhere): BASE_URL = that page address, ALLOWED_ORIGIN = same address
ALLOWED_ORIGIN=
OWNER_PIN=1234                        # CHANGE THIS before real use
AGENT_TOKEN=change-me-agent-token     # CHANGE THIS; the shop PC agent must use the same value

# Payments: "mock" = demo buttons, no money. "razorpay" = real gateway (use Razorpay TEST keys first).
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agent settings (used by agent/agent.js on the shop PC)
SERVER_URL=http://localhost:3000
DRY_RUN=1                             # 1 = save PDFs to ./printed instead of printing. Set 0 on the shop PC.
